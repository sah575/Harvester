[Unit]
Description=Harvester relay sunucusu (odalar ve paket taşıma)
After=network-online.target
Wants=network-online.target

[Service]
User=harvester
Group=harvester
WorkingDirectory=/opt/harvester-relay/app
ExecStart=/usr/bin/dotnet /opt/harvester-relay/app/HarvesterRelay.dll --port 7778
Restart=always
RestartSec=2
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1

# Aynı makinedeki diğer servislerin önünde işlemci sırası alsın: gecikme önemli, yük çok küçük.
Nice=-5
CPUWeight=200
CPUQuota=100%
MemoryMax=256M

# Sertleştirme. MemoryDenyWriteExecute açılmaz: .NET JIT buna ihtiyaç duyar.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target

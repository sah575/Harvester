<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RelayTfm Condition="'$(RelayTfm)' == ''">net8.0</RelayTfm>
    <TargetFramework>$(RelayTfm)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiteNetLib" Version="1.3.5" />
    <Compile Include="../../Assets/scripts/Net/RelayProtocol.cs" Link="RelayProtocol.cs" />
  </ItemGroup>

</Project>
